# .env.example — copy to .env.local and fill in values. NEVER commit .env.local.
# Blank fields are intentional: the value doesn't exist yet. Fill them in when it does — do not delete the field.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Wikimedia (keyless open APIs; a descriptive User-Agent is REQUIRED or Wikimedia answers 403) ---
# Format: "<app>/<version> (<contact url or e-mail>)". Used only by the same-origin proxy route and the data scripts.
WIKI_USER_AGENT="WorldHistoryWeb/0.1 (local demo; contact: )"

# --- Content provider: live = proxy fetches Wikipedia summaries on click; static = curated text only (offline) ---
CONTENT_PROVIDER=live

# --- InvokeAI (Phase 5, optional, build-time only; localhost only — see docs/OPERATIONS.md § InvokeAI) ---
INVOKEAI_URL=http://127.0.0.1:9090
